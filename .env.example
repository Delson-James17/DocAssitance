# Copy this file to ".env" and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: change the port the server runs on (default 3000)
# PORT=3000

# Supabase — saved Q&A pairs are stored in a Postgres table so they survive
# server restarts. Get these from your project's Settings > API page. The
# VITE_ prefix also makes these load-able from the same .env for the
# frontend build if you ever need them there; the server reads either name.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: a service-role key lets the server bypass table RLS policies.
# Recommended for this app since it's a single-user, server-only integration
# (never expose a service-role key to the browser). Falls back to the anon
# key above if omitted — see README.md for the RLS policies that requires.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
